APP_NAME="TV Tracker"
APP_URL=http://localhost:8081
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Set to * when running behind a reverse proxy (nginx, Traefik, etc.) to trust X-Forwarded-Proto
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=debug

DB_ROOT_PASSWORD=root
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# TMDB — https://www.themoviedb.org/settings/api (free)
TMDB_API_KEY=

# Trakt — https://trakt.tv/oauth/applications (free). Used as fallback/cross-check when TMDB fails or a show isn't found.
TRAKT_CLIENT_ID=

# Web push (PWA notifications). `php artisan webpush:vapid` won't work here (it
# writes to src/.env, which doesn't exist in this setup) — generate a keypair via
# `Minishlink\WebPush\VAPID::createVapidKeys()` in `docker compose exec app php artisan tinker`
# instead, and paste the values in here. VAPID_SUBJECT is a mailto: or https: URL
# identifying you as the sender, per the push spec.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bitcoin address shown on /donate. Leave blank to hide that section.
DONATE_BTC_ADDRESS=

# Email — Brevo SMTP. Set MAIL_MAILER=log locally to keep emails in storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tv-tracker.espifam.com
MAIL_FROM_NAME="TV Tracker"
